{% raw -%}
name: Release build

# Builds the archives a release attaches, one per target. The release workflow calls it. It also
# runs on pull requests that change what goes into the build, and by hand from the Actions tab.
on:
  workflow_call:
    inputs:
      ref:
        description: The commit or tag to build
        type: string
        required: true
  workflow_dispatch:
  pull_request:
    paths:
      - .cargo/**
      - .github/workflows/build-release.yml
      - Cargo.lock
      - Cargo.toml
      - LICENSE*
      - README.md
      - about.hbs
      - about.toml
      - crates/*/Cargo.toml
      - crates/*/build.rs
{%- endraw %}
{%- if build.setup %}
      - .github/setup-build.sh
{%- endif %}
{%- if web_ui %}
      - crates/{{ crate_name }}/web/**
{%- endif %}
{%- if release.files %}
      - release/**
{%- endif %}
{%- raw %}
      - rust-toolchain.toml

permissions:
  contents: read

env:
  CARGO_TERM_COLOR: always

jobs:
  build:
    name: ${{ matrix.target }}
    runs-on: ${{ matrix.os }}
{%- endraw %}
    timeout-minutes: {{ build.timeout | default(60) }}
{%- raw %}
    strategy:
      fail-fast: false
      matrix:
        include:
{%- endraw %}
{%- for target in targets %}
          - os: {{ target.runner }}
            target: {{ target.triple }}
{%- if target.triple in release.files %}
            files: {{ release.files[target.triple] | join(' ') }}
{%- endif %}
{%- if target.triple in release.installer | default({}) %}
            installer: {{ release.installer[target.triple].file }}
{%- endif %}
{%- endfor %}
{%- raw %}
    defaults:
      run:
        shell: bash
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: ${{ inputs.ref || github.sha }}
          persist-credentials: false

      - name: Install the pinned toolchain
        env:
          TARGET: ${{ matrix.target }}
        run: |
          rustup toolchain install
          rustup target add "$TARGET"
{%- endraw %}
{%- if build.setup %}

      # .github/setup-build.sh installs what the build needs beyond Rust on each runner, such as
      # system libraries; docs/maintaining.md says what it gets.
      - name: Set up the build
        env:
          TARGET: {% raw %}${{ matrix.target }}{% endraw %}
        run: bash .github/setup-build.sh
{%- endif %}
{%- if 'linux' in platforms and build.libc | default('musl') == 'musl' %}

      # cc, which builds the C code some crates have, needs musl-gcc to build for musl, and finds it
      # on its own only for x86-64, so `CC_<target>` names it.
      - name: Install musl-gcc
        if: runner.os == 'Linux'
        env:
          TARGET: {% raw %}${{ matrix.target }}{% endraw %}
        run: |
          sudo apt-get update
          sudo apt-get install --yes --no-install-recommends musl-tools
          echo "CC_${TARGET//-/_}=musl-gcc" >> "$GITHUB_ENV"
{%- endif %}
{%- raw %}

      - uses: taiki-e/install-action@ab49d3c64680143e184118bed66a46419fc15519 # v2.90.5
        with:
          tool: just@1.59.0,cargo-about@0.9.3
{%- endraw %}
{%- if web_ui %}

      - uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2.2.0
        with:
          bun-version: 1.4.4
          no-cache: true
{%- endif %}
{%- raw %}

      - name: Write the license notices
        run: just notices

      # No cache: a cache written by another workflow could change what ships.
      - name: Build
        env:
          TARGET: ${{ matrix.target }}
{%- endraw %}
{%- if release.env %}
          # The release's own build settings, from the release answer.
{%- for name, value in release.env | dictsort(true) %}
          {{ name }}: "{{ value | replace('\\', '\\\\') | replace('"', '\\"') }}"
{%- endfor %}
{%- endif %}
        run: cargo build --locked --release --package {{ crate_name }} --target "$TARGET"
{%- if web_ui %}

      - name: Build the web UI
        run: just web-build
{%- endif %}
{%- raw %}
{%- endraw %}
{%- if 'windows' in platforms %}

      - name: Check the exe runs without the Visual C++ runtime
        if: runner.os == 'Windows'
        shell: pwsh
        env:
          TARGET: {% raw %}${{ matrix.target }}{% endraw %}
        run: |
          $exe = [IO.File]::ReadAllBytes("target\$env:TARGET\release\{{ project_name }}.exe")
          if ([Text.Encoding]::ASCII.GetString($exe).Contains('VCRUNTIME140')) {
            throw '{{ project_name }}.exe imports VCRUNTIME140.dll, so +crt-static from .cargo/config.toml was not applied.'
          }
{%- endif %}
{%- if release.installer %}
{%- raw %}

      # Inno Setup builds the installer the release answer's installer entry names for this target.
      # The compiler is the version pinned here, checked against its SHA-256 and installed for this
      # run alone, so a change to the runner's own copy never changes what ships.
      - name: Install Inno Setup
        if: matrix.installer
        env:
          URL: https://github.com/jrsoftware/issrc/releases/download/is-7_1_1/innosetup-7.1.1-x64.exe
          SHA256: 8a5a6711c3766a6e5fb74f280ba0e3551e719ce94538d901fdbd1f8f9920b3f0
        run: |
          setup="$RUNNER_TEMP/innosetup.exe"
          dir="$RUNNER_TEMP/inno-setup"
          curl --fail --silent --show-error --location --retry 3 --output "$setup" "$URL"
          echo "$SHA256  $setup" | sha256sum --check --strict --quiet
          # Git Bash would rewrite the installer's `/` options as paths.
          MSYS_NO_PATHCONV=1 "$setup" /VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP- /CURRENTUSER \
            /NOICONS /PORTABLE=1 "/DIR=$(cygpath -w "$dir")" "/LOG=$(cygpath -w "$RUNNER_TEMP/inno-setup.log")"
          "$dir/ISCC.exe" --version
          echo "ISCC=$(cygpath --mixed "$dir/ISCC.exe")" >> "$GITHUB_ENV"
{%- endraw %}
{%- endif %}
{%- if release.files %}
{%- raw %}

      # release/package.sh writes this target's release files, the ones the release answer names,
      # to DIST, and nothing else: every file there is attested and published, under the name the
      # answer gives, and docs/install.md lists them. docs/maintaining.md says what it gets.
{%- endraw %}
{%- if release.installer %}
      # For a target with an installer, the script stages the files to install in STAGING instead,
      # and the step builds the installer from release/installer.iss into DIST itself.
{%- endif %}
{%- raw %}
      - name: Package
        id: archive
        env:
          TARGET: ${{ matrix.target }}
          FILES: ${{ matrix.files }}
{%- endraw %}
{%- if release.installer %}
          INSTALLER: {% raw %}${{ matrix.installer }}{% endraw %}
{%- endif %}
          NAME: {{ project_name }}
          PACKAGE: {{ crate_name }}
{%- if web_ui %}
          WEB: crates/{{ crate_name }}/web/dist
          WEB_NOTICES: target/THIRD-PARTY-LICENSES-WEB.txt
{%- endif %}
{%- raw %}
        run: |
          version=$(cargo metadata --locked --no-deps --format-version 1 \
            | jq -r --arg name "$PACKAGE" '.packages[] | select(.name == $name) | .version')
          binary="target/$TARGET/release/$NAME"
          if [ "$RUNNER_OS" = Windows ]; then binary="$binary.exe"; fi
          export VERSION="$version" BINARY="$binary" NOTICES=target/THIRD-PARTY-LICENSES.html
          export DIST="$PWD/target/release-files"
          if [ -z "$FILES" ]; then
            echo "::error::The release answer in .copier-answers.yml names no files for $TARGET; add them as docs/maintaining.md says."
            exit 1
          fi
          rm -rf "$DIST" dist
          mkdir -p "$DIST"
{%- endraw %}
{%- if release.installer %}
{%- raw %}
          if [ -n "$INSTALLER" ]; then
            export STAGING="$RUNNER_TEMP/staging"
            rm -rf "$STAGING"
            mkdir -p "$STAGING"
          fi
{%- endraw %}
{%- endif %}
{%- raw %}
          bash -eo pipefail release/package.sh
          if [ -e dist ]; then
            echo "::error::release/package.sh wrote dist/, which the release publishes whole; write only to \$DIST."
            exit 1
          fi
{%- endraw %}
{%- if release.installer %}
{%- raw %}
          if [ -n "$INSTALLER" ]; then
            installer=${INSTALLER//\{version\}/$version}
            if [ -e "$DIST/$installer" ]; then
              echo "::error::release/package.sh wrote $installer, which the release builds from release/installer.iss; stage the files it installs in \$STAGING."
              exit 1
            fi
            if [ ! -f "$STAGING/$NAME.exe" ]; then
              echo "::error::release/package.sh staged no $NAME.exe in \$STAGING, which the installer's shortcuts start."
              exit 1
            fi
            # Git Bash would rewrite ISCC's `/` options as paths, so Windows paths go in as defines.
            MSYS_NO_PATHCONV=1 "$ISCC" /Qp "/DTarget=$TARGET" "/DAppVersion=$version" \
              "/DStaging=$(cygpath -w "$STAGING")" "/O$(cygpath -w "$DIST")" "$(cygpath -w release/installer.iss)"
            # Signing: the installer ships unsigned. Signing it would need a trellis change here,
            # passing the sign tool to ISCC with /S, before the checks below and the attestation,
            # with SignTool in release/installer-custom.iss.
          fi
{%- endraw %}
{%- endif %}
{%- raw %}
          expected=$(for file in $FILES; do echo "${file//\{version\}/$version}"; done | sort)
          written=$(cd "$DIST" && find . -mindepth 1 -maxdepth 1 | sed 's|^\./||' | sort)
          if [ "$written" != "$expected" ]; then
            echo "::error::release/package.sh must write exactly the files the release answer names for $TARGET to \$DIST: $(tr '\n' ' ' <<< "$expected"). It wrote: $(tr '\n' ' ' <<< "$written")."
            exit 1
          fi
          for file in $expected; do
            if [ ! -f "$DIST/$file" ] || [ -L "$DIST/$file" ] || [ ! -s "$DIST/$file" ]; then
              echo "::error::release/package.sh wrote $file as something other than a regular file with contents."
              exit 1
            fi
          done
          mkdir -p dist
          mv "$DIST"/* dist/
          echo "artifact=$NAME-$version-$TARGET" >> "$GITHUB_OUTPUT"
{%- endraw %}
{%- else %}
{%- raw %}

      - name: Archive
        id: archive
        env:
          TARGET: ${{ matrix.target }}
{%- endraw %}
          NAME: {{ project_name }}
          PACKAGE: {{ crate_name }}
{%- raw %}
        run: |
          version=$(cargo metadata --locked --no-deps --format-version 1 \
            | jq -r --arg name "$PACKAGE" '.packages[] | select(.name == $name) | .version')
          stem="$NAME-$version-$TARGET"
          mkdir -p "dist/$stem"
{%- endraw %}
          cp {{ {'MIT': 'LICENSE ', 'MIT OR Apache-2.0': 'LICENSE-MIT LICENSE-APACHE '}.get(license, '') }}target/THIRD-PARTY-LICENSES.html{{ ' target/THIRD-PARTY-LICENSES-WEB.txt' if web_ui else '' }} "dist/$stem/"
{%- raw %}
          # The README's relative links and images lead nowhere in the archive, so its copy says
          # where they work: under its title, or at the top when it doesn't open with a `# ` title.
          # Taking out the line and the blank line beside it gives back the README, line endings
          # and a leading byte order mark included, with a line break after a title that had none.
          note="> This file's links and images are relative to $GITHUB_SERVER_URL/$GITHUB_REPOSITORY/tree/v$version."
          bom=$'\xef\xbb\xbf'
          first=$(head -n 1 README.md)
          second=$(LC_ALL=C sed -n 2p README.md)
          eol=$'\n'
          if [[ $first == *$'\r' ]]; then eol=$'\r\n'; fi
          {
            if [[ $first == '# '* || $first == "$bom# "* ]]; then
              printf '%s\n' "$first"
              if (($(tail -n +2 README.md | wc -c) == 0)); then
                printf '%s%s%s' "$eol" "$note" "$eol"
              elif [ -z "${second%$'\r'}" ]; then
                printf '%s\n%s%s%s' "$second" "$note" "$eol" "$eol"
                tail -n +3 README.md
              else
                printf '%s%s%s' "$note" "$eol" "$eol"
                tail -n +2 README.md
              fi
            elif [[ $first == "$bom"* ]]; then
              printf '%s%s%s%s' "$bom" "$note" "$eol" "$eol"
              tail -c +4 README.md
            else
              printf '%s%s%s' "$note" "$eol" "$eol"
              cat README.md
            fi
          } > "dist/$stem/README.md"
{%- endraw %}
{%- if web_ui %}
          cp -R crates/{{ crate_name }}/web/dist "dist/$stem/web"
{%- endif %}
{%- raw %}
          if [ "$RUNNER_OS" = Windows ]; then
            cp "target/$TARGET/release/$NAME.exe" "dist/$stem/"
            (cd dist && 7z a -tzip "$stem.zip" "$stem" > /dev/null)
          else
            cp "target/$TARGET/release/$NAME" "dist/$stem/"
            tar -C dist -czf "dist/$stem.tar.gz" "$stem"
          fi
          rm -r "dist/$stem"
          echo "artifact=$stem" >> "$GITHUB_OUTPUT"
{%- endraw %}
{%- endif %}
{%- raw %}

      # A week is long enough to re-run a failed publish job, and keeps the archives from filling a
      # private repository's storage.
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: ${{ steps.archive.outputs.artifact }}
          path: dist/*
          retention-days: 7
          if-no-files-found: error
{%- endraw %}
