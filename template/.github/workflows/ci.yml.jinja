{%- set os_list = ['linux'] if kind == 'service' else platforms -%}
{% raw -%}
name: CI

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

concurrency:
  # Pull requests share a group so a new push cancels the stale run; every commit on main gets
  # its own run.
  group: ${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.ref || github.sha }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

env:
  CARGO_TERM_COLOR: always

jobs:
  quick:
    name: Quick checks
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - uses: taiki-e/install-action@ab49d3c64680143e184118bed66a46419fc15519 # v2.90.5
        with:
{%- endraw %}
          tool: just@1.59.0,cargo-deny@0.20.2,cargo-shear@1.14.0,typos@1.51.1,taplo@0.10.0,shellcheck@0.11.0,zizmor@1.31.1,lychee@0.24.2{{ ',cargo-about@0.9.3' if kind != 'library' else '' }}
{%- raw %}

      - name: Install the pinned toolchains
        run: just install-toolchains

      # install-action has no actionlint package; the runner image has Go.
      - name: Install actionlint
        run: |
          go install github.com/rhysd/actionlint/cmd/actionlint@v1.7.12
          echo "$(go env GOPATH)/bin" >> "$GITHUB_PATH"

      - uses: Swatinem/rust-cache@d1527c8f67ef9af357290475d4af4b0fab8f12e0 # v2.9.3
        with:
          save-if: ${{ github.ref == 'refs/heads/main' }}

      - run: just fmt-check
      - run: just typos
      - run: just actionlint
      - run: just zizmor
      - run: just shear
      - run: just deny
      - run: just links
{%- endraw %}
{%- if kind == 'library' and publish_crate %}
      - run: just package
{%- endif %}
{%- raw %}
      - run: just policy
{%- endraw %}
{%- if kind != 'library' %}
      - run: just notices
{%- endif %}
{%- raw %}

  build:
    name: ${{ matrix.name }}
    runs-on: ${{ matrix.os }}
    timeout-minutes: 60
    strategy:
      fail-fast: false
      matrix:
        include:
{%- endraw %}
{%- if 'linux' in os_list %}
          - name: Ubuntu
            os: ubuntu-24.04
{%- endif %}
{%- if 'macos' in os_list %}
          - name: macOS
            os: macos-26
{%- endif %}
{%- if 'windows' in os_list %}
          - name: Windows
            os: windows-2025
{%- endif %}
{%- raw %}
    env:
      NEXTEST_PROFILE: ci
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      # cargo-dylint has no download for Windows, so install-action builds it there, and the cache
      # keeps the build.
      - uses: Swatinem/rust-cache@d1527c8f67ef9af357290475d4af4b0fab8f12e0 # v2.9.3
        with:
          save-if: ${{ github.ref == 'refs/heads/main' }}

      - uses: taiki-e/install-action@ab49d3c64680143e184118bed66a46419fc15519 # v2.90.5
        with:
          tool: just@1.59.0,cargo-nextest@0.9.150,cargo-dylint@6.3.0,dylint-link@6.3.0

      # The custom lints run on every platform, so they also check platform-gated code.
      - name: Install the pinned toolchains
        run: just install-toolchains

      - run: just lint
      - run: just dylint
      - run: just test
      - run: just docs
      - run: just build-release

      - name: Upload the test results
        if: always()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: test-results-${{ matrix.name }}
          path: target/nextest/ci/junit.xml
          if-no-files-found: ignore
{%- endraw %}
{%- if kind == 'service' %}

  image:
    name: Container image
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - uses: taiki-e/install-action@ab49d3c64680143e184118bed66a46419fc15519 # v2.90.5
        with:
          tool: just@1.59.0,cargo-about@0.9.3

      - name: Install the pinned toolchain
        run: rustup toolchain install

      - name: Write the license notices the image carries
        run: just notices

      - name: Build the image and run it
        run: |
          docker build --file Containerfile --tag {{ project_name }}:ci .
          docker run --rm {{ project_name }}:ci --version
{%- endif %}

  # Branch protection requires this job instead of each job by name, so `needs` lists every other
  # job, and a new job goes there rather than into branch protection. It runs with
  # `always()` because a job whose needs fail is skipped, and GitHub counts a skipped required
  # check as passing.
  passed:
    name: CI passed
{%- if kind == 'service' %}
    needs: [quick, build, image]
{%- else %}
    needs: [quick, build]
{%- endif %}
{%- raw %}
    if: always()
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    permissions: {}
    steps:
      - name: Check every job passed
        env:
          NEEDS: ${{ toJSON(needs) }}
        run: |
          failed=$(jq --raw-output 'to_entries[] | select(.value.result != "success") | "::error::\(.key) ended with \(.value.result)."' <<< "$NEEDS")
          if [ -n "$failed" ]; then
            echo "$failed"
            exit 1
          fi
{%- endraw %}
