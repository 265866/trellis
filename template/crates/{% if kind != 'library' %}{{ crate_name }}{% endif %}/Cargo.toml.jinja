[package]
name = "{{ crate_name }}"
description = {{ description | tojson }}
version.workspace = true
edition.workspace = true
rust-version.workspace = true
repository.workspace = true
{% if license != 'none' %}license.workspace = true
{% endif %}publish.workspace = true

[[bin]]
name = "{{ project_name }}"
path = "src/main.rs"

[dependencies]
{{ crate_name }}_core = { path = "../{{ crate_name }}_core" }

[lints]
workspace = true
