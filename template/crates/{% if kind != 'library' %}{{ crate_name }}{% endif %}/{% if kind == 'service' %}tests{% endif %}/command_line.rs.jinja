//! Tests for the command line of `{{ project_name }}`.

use std::process::{Command, Output};

/// Runs the built `{{ project_name }}` with `arguments`.
fn run(arguments: &[&str]) -> Output {
    Command::new(env!("CARGO_BIN_EXE_{{ project_name }}"))
        .args(arguments)
        .output()
        .expect("the binary should start")
}

#[test]
fn version_prints_the_version_line_and_succeeds() {
    let output = run(&["--version"]);
    assert!(
        output.status.success(),
        "CI's Container image job runs the image with `--version` and needs exit 0: {output:?}"
    );
    assert_eq!(
        String::from_utf8_lossy(&output.stdout),
        format!("{}\n", {{ crate_name }}_core::version_line()),
        "`--version` should print the version line"
    );
}

#[test]
fn an_unknown_argument_fails() {
    let output = run(&["--unknown"]);
    assert_eq!(
        output.status.code(),
        Some(2),
        "an argument the service doesn't know should fail: {output:?}"
    );
}
