{%- set os_list = ['linux'] if kind == 'service' else platforms -%}
# `just deny` checks dependencies for advisories, licenses, banned crates and sources.
[graph]
targets = [
{%- if 'linux' in os_list %}
    "x86_64-unknown-linux-gnu",
{%- endif %}
{%- if 'macos' in os_list %}
    "aarch64-apple-darwin",
{%- endif %}
{%- if 'windows' in os_list %}
    "x86_64-pc-windows-msvc",
{%- endif %}
]
all-features = true

[advisories]
# An unmaintained crate fails only when this project depends on it directly.
unmaintained = "workspace"
ignore = []

[licenses]
{%- if kind != 'library' %}
# Keep this list in step with `accepted` in about.toml, which writes the release's license notices.
{%- endif %}
allow = ["Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "ISC", "MIT", "Unicode-3.0", "Zlib"]
confidence-threshold = 0.9

[licenses.private]
ignore = true

[bans]
multiple-versions = "warn"
wildcards = "deny"
allow-wildcard-paths = true

[[bans.deny]]
crate = "ctor"
reason = "Google Rust Style Guide: don't run code before main()"

[[bans.deny]]
crate = "inventory"
reason = "Google Rust Style Guide: don't run code before main()"

[[bans.deny]]
crate = "linkme"
reason = "Google Rust Style Guide: don't run code before main()"

[[bans.deny]]
crate = "paste"
reason = "builds identifiers and attributes the custom lints can't read"

[[bans.deny]]
crate = "pastey"
reason = "builds identifiers and attributes the custom lints can't read"

[sources]
unknown-registry = "deny"
unknown-git = "deny"
